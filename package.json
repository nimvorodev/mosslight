{
  "name": "mosslight",
  "private": true,
  "version": "0.1.0",
  "description": "Mosslight - a living pixel terrarium for your desktop",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Mosslight",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm run smoke",
    "icons": "node scripts/make-icons.mjs",
    "dev:desktop": "concurrently -k \"vite --port 5174 --strictPort\" \"wait-on http://localhost:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "start:desktop": "npm run build && electron .",
    "shot": "npm run build && cross-env MOSS_SHOT=1 MOSS_SHOT_DIR=build/shots electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "productName": "Mosslight",
  "build": {
    "appId": "app.mosslight.terrarium",
    "productName": "Mosslight",
    "copyright": "Mosslight",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Mosslight-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mosslight"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "wait-on": "^9.5.1"
  }
}
